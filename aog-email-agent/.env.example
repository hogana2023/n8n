# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# These are read by the dev tooling only. n8n itself stores credentials in its own
# encrypted credential store, so the Outlook values below go into the n8n UI, not here.

# Entra ID app registration for the mailbox (see docs/outlook-setup.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX_UPN=

# Model access for `npm run eval`
ANTHROPIC_API_KEY=

# Only needed once the approval gate is cleared for live writes
PIPEDRIVE_API_TOKEN=

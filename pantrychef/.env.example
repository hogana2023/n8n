# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Nothing here is optional except Google OAuth.
# ---------------------------------------------------------------------------

# Postgres. Any provider works: local Docker, Neon, Supabase, RDS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pantrychef?schema=public"

# The public origin, used for Stripe redirects and OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js. NEXTAUTH_SECRET must be set in production.
# Generate one with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional: enables "Continue with Google". Leave blank to use email only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Stripe. Use test keys (sk_test_… / whsec_…) until you're ready to charge.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Price IDs from your Stripe dashboard. Create two recurring prices per paid
# plan, one monthly and one yearly, then paste their price_… ids here.
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_FAMILY_MONTHLY=""
STRIPE_PRICE_FAMILY_YEARLY=""

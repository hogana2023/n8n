generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   Plan      @default(FREE)

  // Preferences that condition every generation.
  cuisines     String[] @default([])
  dietary      String[] @default([])
  dislikes     String[] @default([])
  appliances   String[] @default([])

  accounts    Account[]
  sessions    Session[]
  pantryItems PantryItem[]
  recipes     Recipe[]
  mealPlans   MealPlan[]
  purchases   CookbookPurchase[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// PantryChef
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PLUS
  FAMILY
}

/// What the recipe was generated from. Drives which generator prompt runs and
/// which cookbook a recipe is filed into.
enum RecipeKind {
  PANTRY // from the full pantry
  LEFTOVERS // from cooked food that needs using up
  APPLIANCE // targeted at one appliance
  PET // PantryPup
}

model PantryItem {
  id        String    @id @default(cuid())
  userId    String
  name      String
  slug      String
  category  String    @default("other")
  quantity  String?
  expiresAt DateTime?
  /// True when the item came from a photo rather than being typed.
  fromPhoto Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model Recipe {
  id String @id @default(cuid())
  /// Null for curated recipes that belong to a cookbook rather than a person.
  userId String?
  kind   RecipeKind @default(PANTRY)

  title       String
  summary     String
  minutes     Int
  servings    Int
  difficulty  String @default("easy")
  cuisine     String @default("everyday")
  /// "air-fryer", "instant-pot", "slow-cooker", "oven", "hob" — null for any.
  appliance   String?

  ingredients Json // [{ item, amount, have }]
  steps       String[]
  tips        String[] @default([])
  nutrition   Json? // { calories, protein, carbs, fat } — per serving

  /// Dietary tags the generator asserted this recipe satisfies.
  dietary     String[] @default([])

  /// The model that produced it, for provenance when a recipe reads oddly.
  model       String   @default("claude-opus-5")
  saved       Boolean  @default(false)
  cooked      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries CookbookEntry[]

  @@index([userId, kind])
  @@index([userId, saved])
}

model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  days      Int      @default(7)
  /// [{ day, meals: [{ slot, title, recipeId? }] }]
  plan      Json
  /// Aggregated shopping list minus what the pantry already covers.
  shopping  Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A purchasable collection. Recipes are filed in automatically by category;
/// an editor curates which collections go on sale.
model Cookbook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String
  coverColor  String   @default("#1d7a4c")
  /// One-time price in pence.
  pricePence  Int      @default(900)
  /// The Stripe price id for the one-time purchase.
  stripePriceId String?
  category    String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  entries   CookbookEntry[]
  purchases CookbookPurchase[]
}

model CookbookEntry {
  id         String @id @default(cuid())
  cookbookId String
  recipeId   String
  position   Int    @default(0)

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, recipeId])
  @@index([cookbookId])
}

model CookbookPurchase {
  id                    String   @id @default(cuid())
  userId                String
  cookbookId            String
  stripeCheckoutSession String   @unique
  amountPence           Int
  purchasedAt           DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)

  @@unique([userId, cookbookId])
  @@index([userId])
}

/// Per-user, per-day generation counter. The free plan gets a small daily
/// allowance; this is what enforces it without a cron job to reset anything.
model GenerationLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  day       String // YYYY-MM-DD in UTC
  count     Int      @default(1)

  @@unique([userId, kind, day])
  @@index([userId, day])
}
